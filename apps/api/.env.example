# Copy to .env (and to .env.test with a separate database for `pnpm test`).
# Local development values only — never commit real credentials.
NODE_ENV=development
PORT=3001

# Runtime connection: least-privilege application role (member of proofline_app; 03 §20).
DATABASE_URL=postgresql://proofline_app_user:proofline_app_dev@localhost:5432/proofline_dev

# Migration connection: schema owner, used by the Prisma CLI (schema.prisma `directUrl`).
DATABASE_MIGRATION_URL=postgresql://proofline_owner:proofline_owner_dev@localhost:5432/proofline_dev

# Only for `pnpm --filter @proofline/api db:drift` (an empty scratch database).
SHADOW_DATABASE_URL=postgresql://proofline_owner:proofline_owner_dev@localhost:5432/proofline_shadow

# Server secret for sign-in code and client-fingerprint HMACs (≥ 32 random characters).
# Generate with: openssl rand -base64 48. Rotating it invalidates outstanding codes.
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48
# The web origin allowed to send POST/PATCH/DELETE requests (CSRF Origin check).
WEB_ORIGIN=http://localhost:3000
# Sign-in code delivery. `console` prints the email locally and is refused in production.
EMAIL_TRANSPORT=console
# Trusted reverse-proxy hops in front of the API (for the client fingerprint). 0 = none.
TRUST_PROXY=0

# Private S3-compatible evidence storage (OD-14). Values below match the local SeaweedFS
# service in docker-compose.yml. For AWS S3, omit STORAGE_ENDPOINT and use path style false.
STORAGE_DRIVER=s3
STORAGE_BUCKET=proofline-evidence
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=proofline-dev
STORAGE_SECRET_ACCESS_KEY=proofline-dev-secret

# Run the analysis worker in this process (OD-15). Set to false for an API-only instance.
WORKER_ENABLED=true

# AI gateway (OD-02, AD-06). No vendor adapter is chosen yet, so `none` is the only provider:
# EXTRACT then uses deterministic rule candidates only and makes no model call.
LLM_PROVIDER=none
# LLM_MODEL=
LLM_TIMEOUT_MS=20000
# off | auto | force — cached results only for the synthetic manifest, always disclosed (FR-027).
DEMO_FALLBACK=off
# Defaults to <repo>/synthetic (manifest.json + fallback/<STEP>/<sha256>.json).
# SYNTHETIC_DIR=
