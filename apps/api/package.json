{
  "name": "@proofline/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @proofline/shared build && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @proofline/shared build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @proofline/shared build && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:drift": "sh -c 'if [ -f .env ]; then set -a; . ./.env; set +a; fi; prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code'",
    "storage:init": "node --env-file-if-exists=.env scripts/storage-init.mjs",
    "storage:init:test": "node --env-file-if-exists=.env.test scripts/storage-init.mjs",
    "queue:install": "node --env-file-if-exists=.env scripts/queue-install.mjs",
    "queue:install:test": "node --env-file-if-exists=.env.test scripts/queue-install.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "6.19.3",
    "@proofline/shared": "workspace:*",
    "@tesseract.js-data/eng": "1.0.0",
    "express": "^5.2.1",
    "html-to-text": "10.0.1",
    "jimp": "1.6.1",
    "mailparser": "3.9.33",
    "pdf-lib": "^1.17.1",
    "pdf2json": "4.1.0",
    "pg-boss": "11.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "7.0.0",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jimp/plugin-print": "1.6.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  }
}
