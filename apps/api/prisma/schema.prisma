// Proofline database schema — implements docs/03-DATABASE-SCHEMA.md (v1.1).
//
// Prisma cannot express every construct the specification requires. The following are
// written as hand-authored SQL in prisma/migrations/*_init/migration.sql and are documented
// next to the affected models below:
//   - the `case_reference_seq` sequence (03 §5.1)
//   - CHECK constraints (limits, hashes, "non-null iff" rules, urgency G2-v1, exclusive arcs)
//   - partial unique / partial indexes (03 §21)
//   - generated columns `evidence_items.evidence_ref` and `source_pages.has_usable_text_layer`
//   - `UNIQUE NULLS NOT DISTINCT` on `fact_sources` (03 §11.2)
//   - `ON DELETE SET NULL (column)` on composite case-scoped foreign keys (PostgreSQL 15+)
//   - immutability triggers (03 §28.3) and the append-only `audit_logs` trigger (03 §19.4)
//   - the views `entity_evidence_links` and `case_overview` (03 §5.3, §11.1)
//   - the least-privilege application role grants (03 §20)
//
// Case isolation (03 §20): every case-owned table carries `case_id`, every parent exposes
// `UNIQUE (id, case_id)`, and children reference parents through composite `(x_id, case_id)`
// foreign keys so a row can never point at a parent in another case.
//
// Relations declared `onDelete: SetNull` on a composite key trigger a Prisma warning because
// `case_id` is required. The migration narrows these to `SET NULL (x_id)`, which leaves
// `case_id` untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

